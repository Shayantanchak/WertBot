# =============================================================================
# WertBot — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to version control.
# =============================================================================

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# ── API Gateway ───────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wertbot
DB_USER=wertbot_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── Google Gemini / Vertex AI ─────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
# Path to service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json
GEMINI_MODEL=gemini-2.5-pro

# ── Plaid (Open Banking) ──────────────────────────────────────────────────────
# Sign up at: https://dashboard.plaid.com/
PLAID_CLIENT_ID=REPLACE_WITH_PLAID_CLIENT_ID
PLAID_SECRET=REPLACE_WITH_PLAID_SECRET
PLAID_ENV=sandbox          # sandbox | development | production

# ── Binance (Crypto WebSocket) ────────────────────────────────────────────────
# Only needed for Phase 3 (HFT Engine). Leave blank for Phase 1+2.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── OANDA (Forex) ─────────────────────────────────────────────────────────────
# Register at: https://www.oanda.com/apply/demo/
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice         # practice | live

# ── Stripe (Neobanking - Phase 4) ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TREASURY_FINANCIAL_ACCOUNT=

# ── Email (Nodemailer/SendGrid) ───────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_API_KEY
FROM_EMAIL=noreply@wertbot.ai

# ── AlphaSense (Research) ─────────────────────────────────────────────────────
ALPHASENSE_API_KEY=

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_PASSWORD=admin

# ── Service Ports ─────────────────────────────────────────────────────────────
PFM_SERVICE_PORT=3001
AI_SERVICE_PORT=3002
TRADING_SERVICE_PORT=3003
BANKING_SERVICE_PORT=3004
